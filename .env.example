# Токен бота от @BotFather. Обязательное поле.
BOT_TOKEN=123456:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram user_id админов через запятую. Им доступна команда /reload.
# Свой id можно узнать у @userinfobot.
ADMIN_IDS=123456789

# Канал бренда, на который проверяется подписка в разделе «Астропрогноз 2027».
CHANNEL_USERNAME=@maluna118
CHANNEL_URL=https://t.me/maluna118

# Где лежит база. Внутри Docker путь примонтирован томом.
DB_PATH=data/maluna.db

# Папка с контент-файлами.
CONTENT_DIR=content

# Порт health-check эндпоинта: GET /health
HEALTH_PORT=8080

# Уровень логов: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Опционально. Если задано — состояние диалогов хранится в Redis с TTL 30 минут,
# иначе в памяти процесса. Для одного инстанса память подходит полностью.
# REDIS_URL=redis://localhost:6379/0
